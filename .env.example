# ── Polymarket ──────────────────────────────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYGON_PRIVATE_KEY=          # L1 wallet private key (0x...)
POLYGON_RPC_URL=https://polygon-rpc.com
# WebSocket RPC for on-chain trade detection (~2-4s latency vs ~6-13s polling)
# Free public node works but Alchemy/Infura/QuickNode is more reliable:
#   wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
#   wss://polygon.infura.io/ws/v3/YOUR_KEY
POLYGON_WS_RPC_URL=wss://polygon-bor-rpc.publicnode.com

# ── Claude AI ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Trading behaviour ────────────────────────────────────────────────────────
TRADING_MODE=paper             # paper | live
COPY_SCALE=0.10                # fraction of target position size to copy (10%)
MAX_EXPOSURE_PER_MARKET=50     # USDC max per market
MAX_TOTAL_EXPOSURE=500         # USDC total portfolio cap
MIN_BOT_SCORE=70               # 0-100 threshold for selecting a wallet to copy
SCAN_INTERVAL_SECONDS=3600     # how often to re-run the leaderboard scan
MAX_TARGET_WALLETS=10          # max wallets to copy simultaneously
POLL_INTERVAL_SECONDS=3        # how often to poll each target wallet for new trades

# ── Optional: pin specific wallets instead of auto-discovery ─────────────────
# TARGET_WALLETS=0xabc...,0xdef...

# ── Position management ──────────────────────────────────────────────────────
TAKE_PROFIT_PCT=0.15           # close at +15% price gain
STOP_LOSS_PCT=0.10             # close at -10% price drop
MAX_HOLD_HOURS=48              # force-close after 48h regardless
PRICE_UPDATE_INTERVAL=60       # seconds between price refresh

# ── Internal ─────────────────────────────────────────────────────────────────
AGENT_HTTP_PORT=8000
LOG_LEVEL=INFO
DB_PATH=./data/agent.db
